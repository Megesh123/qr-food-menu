{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "spice-street-menu-api",
  "main": "src/index.js",
  "compatibility_date": "2026-09-23",
  "workers_dev": true,
  "kv_namespaces": [{ "binding": "MENU_SECRETS" }],
  "secrets": {
    "required": ["ADMIN_CREDENTIAL_SHA256", "MASTER_CREDENTIAL_SHA256"]
  }
}
